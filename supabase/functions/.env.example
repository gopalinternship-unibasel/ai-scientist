# Edge-function environment for the LOCAL stack.
#
# scripts/start-local.ps1 copies this file to supabase/functions/.env (which
# is gitignored) on first start; edit that copy, not this one. The local
# Supabase edge runtime reads supabase/functions/.env automatically.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the Supabase CLI — do not set them here.

# --- Chat model (OpenAI-compatible endpoint) --------------------------------
# Default: the shared local Ollama (CPU only, free, no key). From inside the
# edge-runtime container the host is host.docker.internal.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=ollama
# One model for every role. Override a single role with AI_MODEL_<ROLE>
# (PLAN, FAST, REASONING, GATE, DOMAIN, DISTILL, EVAL_PLAN, JUDGE), each a
# comma-separated fallback chain.
# qwen2.5-7b-4threads is qwen2.5:7b with Ollama's thread count set to 4 and
# an 8192-token context (scripts/start-local.ps1 creates it from qwen2.5:7b,
# no second download; see RUNNING.md). On a busy PC Ollama's default of one
# thread per core stalls: 0.07 vs 0.34 generated tokens/s measured here.
# With Ollama's default 4096-token context a planner prompt plus its plan
# overflows and Ollama drops the instructions mid-answer ("context shift").
# Another model needs the same num_ctx.
#
# Why the 7B model is the default (comparison of 10 Nov 2026, same prompts,
# same literature, RUNNING.md section 6): on the three QA hypotheses its
# plans used the hypothesis' doses, had the readout step and listed the
# compound and the cell line every time, and it wrote no catalog numbers it
# did not know. The 3B model invented catalog numbers (S1000, A1000), listed
# materials from other experiments, changed doses by 100 to 500 times and
# called a paper that says the opposite an "exact match". The price is
# speed: about 3 generated tokens/s against 4 to 6, and prompts are read at
# 7 to 11 tokens/s against 17 to 33, so a run takes roughly twice as long.
AI_MODEL=qwen2.5-7b-4threads
# Faster, less correct (the default until 10 Nov 2026): the 3B variant for
# every role, or only for the short calls (gate, novelty classifier, domain)
# while the 7B model writes the plan. Two loaded models need about 8 GB
# instead of 6.
# AI_MODEL=qwen2.5-3b-4threads
# AI_MODEL_FAST=qwen2.5-3b-4threads
# AI_MODEL_GATE=qwen2.5-3b-4threads
# Ollama ignores tool_choice, so forced tool calls are sent as
# response_format json_schema (grammar-constrained JSON). Hosted providers
# that honour tool_choice can use "tools".
AI_STRUCTURED_OUTPUT=json_schema
AI_MAX_TOKENS_PARAM=max_tokens
# Upper bound on every output budget. A compact plan is about 1,900 tokens;
# the planner prompt is 2,300-3,800 tokens (refinements carry the previous
# plan), so prompt + plan fit the 8192-token context of the local model.
AI_MAX_TOKENS_CAP=3072
# Small CPU-only models: cap every list in structured output at 5 items,
# ask for short text fields and cut long prompt inputs (fewer prompt tokens
# to process on the CPU). Remove (or set false) for hosted models.
AI_COMPACT_OUTPUT=true
# CPU-only models need minutes per call; this floor lifts the original
# 5-90 s per-call budgets. It also covers the time a call waits in a shared
# Ollama's queue before the model starts answering: on 9-10 Nov 2026 two runs
# waited 60 minutes behind other projects' requests and failed at the old
# 60-minute floor, so it is 2 hours. The streamed plan itself has no overall
# deadline once the model starts answering.
AI_MIN_TIMEOUT_MS=7200000

# A plan that breaks a refinement limit ("under $3,000", "8 weeks") or whose
# materials do not fit the hypothesis is generated once more (1, default);
# 0 saves that second plan's model time.
# PLAN_REPAIR_ATTEMPTS=1

# --- Embeddings (feedback retrieval + dedup) --------------------------------
# nomic-embed-text is natively 768-d, matching plan_feedback.embedding.
AI_EMBED_MODEL=nomic-embed-text
# Cosine floor for retrieving past corrections. nomic-embed-text scores
# unrelated biology texts around 0.5-0.6, so 0.7 keeps only close matches
# (the code default 0.55 was tuned for Gemini text-embedding-004).
FEEDBACK_MIN_SIMILARITY=0.7

# --- Optional settings used by the hosted deployment (RUNNING.md, section 11) --
# Leave them unset locally; each one changes nothing while it is absent.
# AI_REASONING_EFFORT=low               # sent as reasoning_effort on every chat call
# AI_EMBED_DIMENSIONS=true              # or a whole number (the column is vector(768))
# LIT_EMBED_MIN_SIMILARITY=0.66         # related-work filter floor (0 to 1)
# LIT_EMBED_MARGIN=0.15
# EXACT_EMBED_MIN=0.78                  # embedding floor for an "exact match" paper
# RUN_LIMIT_GLOBAL_PER_DAY=40           # daily caps on new AI runs; unset = local rule
# RUN_LIMIT_ANON_PER_DAY=3
# RUN_LIMIT_USER_PER_DAY=10

# --- Hosted alternatives (uncomment one block, comment out the block above) --
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=<your OpenAI key>
#   AI_MODEL=gpt-4o-mini
#   AI_STRUCTURED_OUTPUT=tools
#   AI_MAX_TOKENS_PARAM=max_tokens        # max_completion_tokens for gpt-5 / o-series
#   AI_MIN_TIMEOUT_MS=0
#   AI_COMPACT_OUTPUT=false
#   AI_EMBED_MODEL=text-embedding-3-small
#   AI_EMBED_DIMENSIONS=true              # ask for 768-d vectors
#
# Google Gemini (OpenAI-compatible endpoint):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_API_KEY=<your Gemini API key>
#   AI_MODEL=gemini-2.5-flash
#   AI_STRUCTURED_OUTPUT=tools
#   AI_MIN_TIMEOUT_MS=0
#   AI_COMPACT_OUTPUT=false
#   AI_EMBED_MODEL=gemini-embedding-001
#   AI_EMBED_DIMENSIONS=true
#
# Hugging Face router (chat only; keep the local embedding model or use
# another provider for embeddings via AI_EMBED_BASE_URL / AI_EMBED_API_KEY):
#   AI_BASE_URL=https://router.huggingface.co/v1
#   AI_API_KEY=<your HF token>
#   AI_MODEL=Qwen/Qwen2.5-72B-Instruct
#   AI_STRUCTURED_OUTPUT=tools
#   AI_MIN_TIMEOUT_MS=0
#   AI_COMPACT_OUTPUT=false
#   AI_EMBED_BASE_URL=http://host.docker.internal:11434/v1
#   AI_EMBED_API_KEY=ollama
#
# Original Lovable AI gateway (needs a Lovable workspace key; restores the
# original per-role Gemini / GPT-5 chains when no AI_MODEL is set; it has no
# embedding endpoint):
#   AI_BASE_URL=https://ai.gateway.lovable.dev/v1
#   AI_API_KEY=<LOVABLE_API_KEY>
#   AI_STRUCTURED_OUTPUT=tools
#   AI_MAX_TOKENS_PARAM=none
#   AI_MIN_TIMEOUT_MS=0
#   AI_COMPACT_OUTPUT=false
#   AI_EMBED_BASE_URL=http://host.docker.internal:11434/v1
#   AI_EMBED_API_KEY=ollama

# --- Optional ---------------------------------------------------------------
# Free Semantic Scholar API key (https://www.semanticscholar.org/product/api).
# Without it the shared anonymous pool answers HTTP 429 most of the time and
# literature QC relies on OpenAlex and PubMed.
# SEMANTIC_SCHOLAR_API_KEY=
# Shared secret that lets a scheduled job call eval-harness without a JWT.
# EVAL_CRON_SECRET=
