# Placeholders only. Real values never go in this file.
#
# Local run: scripts/start-local.ps1 writes .env.development.local (not
# tracked) with the values of the local Supabase stack; that file wins over
# this one.
# Hosted build: the GitHub Actions variables VITE_SUPABASE_URL,
# VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_PROJECT_ID are passed to the
# build and win over this file. See "Live deployment" in RUNNING.md.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
